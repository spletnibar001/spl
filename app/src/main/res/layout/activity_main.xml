<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/centerBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_bubble"
            android:fontFamily="@font/golos_medium"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/dial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_bubble"
        android:fontFamily="@font/plex_mono_semibold"
        android:minWidth="96dp"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:textColor="@color/accent"
        android:textSize="44sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_osd"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="27dp"
        android:visibility="gone">

    <LinearLayout
        android:id="@+id/osdTop"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/osdNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_mono_semibold"
            android:gravity="end"
            android:includeFontPadding="false"
            android:minWidth="72dp"
            android:textColor="@color/accent"
            android:textSize="44sp" />

        <FrameLayout
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_badge">

            <TextView
                android:id="@+id/osdInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/unbounded_bold"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/osdLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="7dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osdName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/golos_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/osdGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/golos_regular"
                android:maxLines="1"
                android:textColor="@color/muted2"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/osdFav"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            android:visibility="gone"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/osdClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_mono_medium"
            android:textColor="@color/light"
            android:textSize="25sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/osdEpg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_line_top"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/EpgLabel"
                    android:text="@string/epg_now"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/osdNowTime"
                    style="@style/EpgTime" />
            </LinearLayout>

            <TextView
                android:id="@+id/osdNowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/golos_semibold"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/osdNowTrack"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_track"
                    android:orientation="horizontal"
                    android:weightSum="1000">

                    <View
                        android:id="@+id/osdNowBar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/bg_bar" />
                </LinearLayout>

                <TextView
                    android:id="@+id/osdNowLeft"
                    style="@style/EpgTime"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/osdNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_weight="2"
            android:background="@drawable/bg_line_start"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/EpgLabel"
                    android:text="@string/epg_next" />

                <TextView
                    android:id="@+id/osdNextTime"
                    style="@style/EpgTime" />
            </LinearLayout>

            <TextView
                android:id="@+id/osdNextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/golos_medium"
                android:maxLines="1"
                android:textColor="@color/light"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Keycap"
                    android:text="@string/key_right" />

                <TextView
                    style="@style/KeyHint"
                    android:text="@string/hint_info" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/info"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="27dp"
        android:paddingEnd="30dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/infoNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/plex_mono_semibold"
                android:textColor="@color/accent"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/infoName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/golos_semibold"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/infoClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/plex_mono_medium"
                android:textColor="@color/light"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/infoNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/EpgLabel"
                    android:text="@string/epg_now"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/infoNowTime"
                    style="@style/EpgTime" />
            </LinearLayout>

            <TextView
                android:id="@+id/infoNowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:fontFamily="@font/golos_semibold"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_track"
                    android:orientation="horizontal"
                    android:weightSum="1000">

                    <View
                        android:id="@+id/infoNowBar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/bg_bar" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoNowLeft"
                    style="@style/EpgTime"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/infoDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:ellipsize="end"
                android:fontFamily="@font/golos_regular"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="4"
                android:textColor="@color/desc"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/infoDay"
                style="@style/EpgLabel"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Keycap"
                android:text="@string/key_scroll" />

            <TextView
                style="@style/KeyHint"
                android:layout_marginEnd="0dp"
                android:text="@string/hint_scroll" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/infoListBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/infoList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/infoEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/golos_regular"
                android:textColor="@color/muted2"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="27dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left" />

            <HorizontalScrollView
                android:id="@+id/tabsScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fadingEdgeLength="24dp"
                android:focusable="false"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:fontFamily="@font/golos_regular"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/golos_regular"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/muted2"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                style="@style/Keycap"
                android:text="@string/key_ok" />

            <TextView
                style="@style/KeyHint"
                android:text="@string/hint_ok" />

            <TextView
                style="@style/Keycap"
                android:text="@string/key_groups" />

            <TextView
                style="@style/KeyHint"
                android:text="@string/hint_groups" />

            <TextView
                style="@style/Keycap"
                android:text="@string/key_hold_ok" />

            <TextView
                style="@style/KeyHint"
                android:layout_marginEnd="0dp"
                android:text="@string/hint_menu" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/actionMenu"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#B30B0D12"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_menu"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/actionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/golos_semibold"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/actionFav"
                style="@style/MenuItem" />

            <TextView
                android:id="@+id/actionHide"
                style="@style/MenuItem"
                android:text="@string/menu_hide" />

            <TextView
                android:id="@+id/actionHideGroup"
                style="@style/MenuItem" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_bubble"
        android:fontFamily="@font/golos_medium"
        android:maxWidth="480dp"
        android:paddingStart="20dp"
        android:paddingTop="11dp"
        android:paddingEnd="20dp"
        android:paddingBottom="11dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
