<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Keycap">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_keycap</item>
        <item name="android:fontFamily">@font/plex_mono_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/light</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="KeyHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:fontFamily">@font/golos_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
